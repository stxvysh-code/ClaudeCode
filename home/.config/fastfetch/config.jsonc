// Информация о системе в терминале — arch-forest
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "builtin",
    "source": "arch",
    "color": { "1": "green", "2": "green" },
    "padding": { "top": 1, "left": 2, "right": 3 }
  },
  "display": {
    "separator": "  ",
    "color": { "keys": "green", "title": "green" }
  },
  "modules": [
    "title",
    "separator",
    { "type": "os", "key": "󰣇 ОС" },
    { "type": "kernel", "key": " Ядро" },
    { "type": "uptime", "key": "󰅐 Работает" },
    { "type": "packages", "key": "󰏖 Пакеты" },
    { "type": "de", "key": " Окружение" },
    { "type": "wm", "key": " Окна" },
    { "type": "shell", "key": " Оболочка" },
    { "type": "terminal", "key": " Терминал" },
    { "type": "cpu", "key": " Процессор" },
    { "type": "gpu", "key": "󰍛 Видеокарта" },
    { "type": "memory", "key": " Память" },
    { "type": "disk", "key": "󰋊 Диск" },
    { "type": "display", "key": "󰍹 Монитор" },
    "break",
    "colors"
  ]
}
