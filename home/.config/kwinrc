[Desktops]
Number=4
Rows=1

[Plugins]
blurEnabled=true
krohnkiteEnabled=@TILING@
magiclampEnabled=true
squashEnabled=false
wobblywindowsEnabled=true

[Effect-blur]
BlurStrength=10
NoiseStrength=3

[Effect-wobblywindows]
WobblynessLevel=0
MoveWobble=true
ResizeWobble=false

[Script-krohnkite]
screenGapBetween=10
screenGapBottom=10
screenGapLeft=10
screenGapRight=10
screenGapTop=10
floatUtility=true
floatConfig=steam,org.kde.kcalc,kcalc,org.kde.plasma-welcome,org.kde.kdialog,kdialog,zenity,yad,happ,Happ,org.kde.ark,net.lutris.Lutris,lutris,com.usebottles.bottles,pinentry-qt,org.freedesktop.impl.portal.desktop.kde,xdg-desktop-portal-kde,org.kde.kinfocenter:auto=1
ignoreClass=krunner,yakuake,spectacle,kded5,xwaylandvideobridge,plasmashell,ksplashqml,org.kde.plasmashell,org.kde.polkit-kde-authentication-agent-1,org.kde.kruler,kruler,kwin_wayland,ksmserver-logout-greeter,org.kde.spectacle
soleWindowWidth=100
soleWindowHeight=100
keepTilingOnDrag=true
